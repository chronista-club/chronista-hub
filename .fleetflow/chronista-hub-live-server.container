# Chronista Hub server (live) — Podman Quadlet container unit (rootless)。
#
# World Tree meta-registry。 REST(axum/TCP) + Unison(club-unison QUIC/UDP) を
# 1 バイナリで提供 (embedded SurrealDB kv-rocksdb、 ADR-016/018)。
# 命名 ADR-019: live は subdomain prefix 省略 = hub.chronista.club。
#
# === デプロイ形態: rootless (linuxbrew user)、 fleet-worker-01 相乗り ===
#
# 配置 (fleet-worker-01 上):
#   ~linuxbrew/.config/containers/systemd/chronista-hub-live-server.container
#   → systemctl --user daemon-reload && start
#
# 前提:
#   - image `ghcr.io/chronista-club/chronista-hub-server:latest` (stage 非依存)
#   - %h/chronista-hub/.env.live.server を op inject で生成済 (実 secret あり)
#   - %h/chronista-hub/data/live/ を mkdir 済
#
# Port (scratch の 1277x/1278x と衝突しない live 帯 1288x):
#   - 12880:3000/tcp  REST → Caddy が hub.chronista.club を HTTPS 終端し reverse_proxy
#   - 12879:7879/udp  Unison(QUIC) → 直 expose。 federation addr = hub.chronista.club:12879
#
# LIVE 前提 (DEPLOY.md「live」参照):
#   1. ✅ Unison cert: ADR-020 §S1 で CertSource 配線済 (.env.live の CHRONISTA_HUB_CERT_MODE
#      = self-signed、 SAN=hub.chronista.club、 cert DER を CERT_OUT に export → VP が
#      TrustAnchors::Custom に pin)。 federation の direct path = IPv6 GUA (ADR-020 D3)。
#      残るは op 設定 (AAAA レコード + IPv6 UDP firewall、 DEPLOY.md Step 0)。
#   2. /@handle public route: hub は現状 /v1/tree/{handle} のみ (federation と独立した別トラック)。
#   3. portal: apex landing は pure Caddy (別 service 不要)。

[Unit]
Description=Chronista Hub server (live) — World Tree meta-registry (REST + Unison/QUIC)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/chronista-club/chronista-hub-server:latest
# :latest は local cache が在ると podman が再 pull しない → restart 時に registry の最新を取得。
# (2026-06-28 に古い :latest を掴む stale-image 罠を踏んだ。DEPLOY.md「live」参照)
Pull=newer
ContainerName=chronista-hub-live-server
EnvironmentFile=%h/chronista-hub/.env.live.server
PublishPort=12880:3000/tcp
PublishPort=12879:7879/udp
Volume=%h/chronista-hub/data/live:/app/data:z

Label=fleetflow.project=chronista-hub
Label=fleetflow.stage=live
Label=fleetflow.service=chronista-hub-server

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
