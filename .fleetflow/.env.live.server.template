# chronista-hub live — server 環境変数テンプレート。
#
# 生成: op inject -i .fleetflow/.env.live.server.template -o %h/chronista-hub/.env.live.server
#
# live = 実 auth (Creo ID JWKS 実検証)。 scratch と違い STUB_* は使わない。

# --- REST (axum/TCP) ---
CHRONISTA_HUB_PORT=3000

# --- Unison (QUIC/UDP) — IPv6 GUA = 接続の principal (ADR-020 D3) ---
# 全 interface bind ([::] = IPv6 GUA 到達を受ける)。 VP は hub を hostname
# hub.chronista.club (AAAA → GUA) で dial する (cert SAN は安定 DNS 名で済む)。
CHRONISTA_HUB_UNISON_ADDR=[::]:7879
# cert (ADR-020 §S1 / cert 永続化 = 実 CA path、 決定 2026-06-28 mito):
#   file mode = 実 CA cert (Let's Encrypt)。 VP は TrustAnchors::System (webpki-roots、
#   ISRG Root 含む) で検証 → cert 配布も pin も不要、 cert が回っても client 無変更
#   (= self-signed の「restart で cert 変化 → pin 済 client 弾かれる」脆さの根絶)。
#   fullchain+key は acme.sh が DNS-01 (CF token) で data/live に deploy → 90日更新 reload も
#   acme.sh (DEPLOY.md「live」Step 1)。 container 内 path = /app/data (host data/live を mount)。
CHRONISTA_HUB_CERT_MODE=file
CHRONISTA_HUB_CERT_PATH=/app/data/unison-cert.pem        # LE fullchain (leaf+intermediate)
CHRONISTA_HUB_CERT_KEY_PATH=/app/data/unison-key.pem     # LE privkey
# (fallback) self-signed quickstart — cert 未発行の暫定。 VP は DER を TrustAnchors::Custom に pin。
#CHRONISTA_HUB_CERT_MODE=self-signed
#CHRONISTA_HUB_CERT_SANS=hub.chronista.club,localhost,::1,127.0.0.1
#CHRONISTA_HUB_CERT_OUT=/app/data/unison-cert.der
# federation discovery auth (ADR-020 §S3): 2026-07-04 に required へ反転済み (mito 判断)。
# 未認証は Register/Discover/relay すべて拒否 — permissive に戻すと匿名 Discover で
# 全 world + GUA endpoint が露出する (反転の発端問題が再発する) ので戻さないこと。
# client は VP_OIDC_AUDIENCE=https://hub.chronista.club 付き `vp auth login` が必須。
CHRONISTA_HUB_FEDERATION_AUTH=required

# --- embedded SurrealDB (kv-rocksdb) ---
CHRONISTA_HUB_DB_PATH=/app/data/hub.rocksdb
SURREALDB_NAMESPACE=chronista
SURREALDB_DATABASE=hub
AUTO_MIGRATE_ENABLED=true
MIGRATIONS_DIR=/app/migrations

# --- auth (live: Creo ID JWKS 実検証、 ADR-002/010) ---
# STUB_* は設定しない (default false = fail-closed)。
CREO_ID_ISSUER=https://id.creo-memories.in/
CREO_ID_JWKS_URL=https://id.creo-memories.in/.well-known/jwks.json
# aud = Auth0 の hub 専用 API (resource server) の identifier。旧値 `chronista-hub` は
# Auth0 tenant に対応 API が無く発行し得ない aud だった (VP 実測 2026-07-04)。
# Auth0 API: "Chronista Hub" id=6a48119de41589273d5b7f48 (chronista.club 直下は portal 予約)。
CREO_ID_AUDIENCES=https://hub.chronista.club
JWKS_REFRESH_SECS=300

# --- admin API (token 発行/rotate/revoke) ---
# live の admin key は 1Password から注入 (未設定なら管理 API は 404)。
HUB_ADMIN_KEY={{ op://FleetFlowVault/chronista-hub-live/admin-key }}

# --- logging ---
RUST_LOG=info
