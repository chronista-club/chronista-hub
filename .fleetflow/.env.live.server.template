# chronista-hub live — server 環境変数テンプレート。
#
# 生成: op inject -i .fleetflow/.env.live.server.template -o %h/chronista-hub/.env.live.server
#
# live = 実 auth (Creo ID JWKS 実検証)。 scratch と違い STUB_* は使わない。

# --- REST (axum/TCP) ---
CHRONISTA_HUB_PORT=3000

# --- Unison (QUIC/UDP) — IPv6 GUA = 接続の principal (ADR-020 D3) ---
# 全 interface bind ([::] = IPv6 GUA 到達を受ける)。 VP は hub を hostname
# hub.chronista.club (AAAA → GUA) で dial する (cert SAN は安定 DNS 名で済む)。
CHRONISTA_HUB_UNISON_ADDR=[::]:7879
# cert (ADR-020 §S1 — 旧「CertSource 未実装」負債は解消済):
#   self-signed = quickstart。 SAN に hub.chronista.club を含め、 起動時に cert DER を
#   CERT_OUT に export → VP がそれを TrustAnchors::Custom に pin。
#   「誰でも繋がる」public scale に上げる時は file mode (実 CA cert + System trust) へ。
CHRONISTA_HUB_CERT_MODE=self-signed
CHRONISTA_HUB_CERT_SANS=hub.chronista.club,localhost,::1,127.0.0.1
CHRONISTA_HUB_CERT_OUT=/app/data/unison-cert.der
# federation discovery auth (ADR-020 §S3): VP が connect_with_credential 追従までは
# permissive (現 client 無回帰)、 追従後に required へ。
CHRONISTA_HUB_FEDERATION_AUTH=permissive

# --- embedded SurrealDB (kv-rocksdb) ---
CHRONISTA_HUB_DB_PATH=/app/data/hub.rocksdb
SURREALDB_NAMESPACE=chronista
SURREALDB_DATABASE=hub
AUTO_MIGRATE_ENABLED=true
MIGRATIONS_DIR=/app/migrations

# --- auth (live: Creo ID JWKS 実検証、 ADR-002/010) ---
# STUB_* は設定しない (default false = fail-closed)。
CREO_ID_ISSUER=https://id.creo-memories.in/
CREO_ID_JWKS_URL=https://id.creo-memories.in/.well-known/jwks.json
CREO_ID_AUDIENCES=chronista-hub
JWKS_REFRESH_SECS=300

# --- admin API (token 発行/rotate/revoke) ---
# live の admin key は 1Password から注入 (未設定なら管理 API は 404)。
HUB_ADMIN_KEY={{ op://FleetFlowVault/chronista-hub-live/admin-key }}

# --- logging ---
RUST_LOG=info
