# chronista-hub scratch — server 環境変数テンプレート。
#
# 生成: op inject -i .fleetflow/.env.scratch.server.template -o %h/chronista-hub/.env.scratch.server
# (Quadlet の EnvironmentFile= が読む)。
#
# scratch = no-auth sandbox (OR 先例: scratch は no-auth public)。 実 auth に
# 上げる場合は STUB_* を外し CREO_ID_ISSUER / CREO_ID_JWKS_URL / CREO_ID_AUDIENCES を設定。

# --- REST (axum/TCP) ---
CHRONISTA_HUB_PORT=3000

# --- Unison (QUIC/UDP) ---
# container 内は全 interface bind。 loopback default ([::1]) を override すること。
CHRONISTA_HUB_UNISON_ADDR=[::]:7879

# --- embedded SurrealDB (kv-rocksdb) ---
CHRONISTA_HUB_DB_PATH=/app/data/hub.rocksdb
SURREALDB_NAMESPACE=chronista
SURREALDB_DATABASE=hub
AUTO_MIGRATE_ENABLED=true
MIGRATIONS_DIR=/app/migrations

# --- auth (scratch sandbox) ---
STUB_AUTH_ALLOWED=true
STUB_APP_TOKEN_ALLOWED=true

# --- logging ---
RUST_LOG=info

# --- admin API (任意) ---
# 設定すると /v1/apps/{id}/tokens の発行/rotate/revoke が有効化 (未設定なら 404)。
# scratch で product-token 発行を試すなら op secret を注入:
# HUB_ADMIN_KEY={{ op://FleetFlowVault/chronista-hub-scratch/admin-key }}
