# chronista-hub live: 予防 restart の daily スケジュール (issue #35)。
#
# 19:00 UTC = 04:00 JST の低トラフィック帯に restart。 RandomizedDelaySec で分散。
# Persistent=true で sleep/down 跨ぎの取りこぼしを次回起動時に補完。
#
# 配置: ~/.config/systemd/user/chronista-hub-live-restart.timer
[Unit]
Description=chronista-hub live 予防 restart daily (issue #35)

[Timer]
OnCalendar=*-*-* 19:00:00 UTC
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
