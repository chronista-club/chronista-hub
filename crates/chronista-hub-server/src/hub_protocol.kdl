// Chronista Hub — Unison protocol schema。
// node↔hub の registry/discovery を Unison channel (QUIC) で提供する。
// resource ingestion / tree read は REST (axum) 据え置き。
//
// MVP scope: 単一 hub 内で 2 つの VP node が相互に discovery する (ADR pending、
// federation = multi-hub は ~6-12mo)。`unison.discovery` は enable_discovery が配信する
// self-description channel (server 自身の protocol.kdl + hash)。
// v0.2.0 (ADR-020 §S2): nodes.Register に node_id (location 独立 routing key) と
// endpoints (direct 到達候補、 string 配列 "[GUA]:port") を additive 追加。
// hub は node_id keyed で index し Discover で node_id+endpoints を返す。 endpoints は
// opaque な順序付き候補リスト (dialer=VP が解釈、 relay は混ぜない別レイヤー)。
// v0.3.0: nodes.Unregister を additive 追加 (registry lifecycle — 自身の登録を撤回。
// node_id keyed の DELETE、 idempotent)。 Register と同じ federation.register scope。
// v0.4.0 (ADR-020 §S4): relay channel を additive 追加 (universal floor — direct 全滅時に
// hub が source→target を中継)。 source が open で {to,from} を宣言 → hub が target の
// server-initiated stream (club-unison 1.5.0) に forward。 片方向 (D5「片方向 tell」)、 opaque。
// v0.5.0 (ADR-020 §S5): owner/visibility 分離。 Register が connection principal の usr_id を
// owner として記録し、 visibility ('public'|'private'、 省略時: 認証済=private / 未認証=public、
// 'shared' は audience/group モデル導入まで予約) を additive 受理。 Discover は
// 「自分が owner の node + public」のみ返す (未認証 permissive は public のみ)。
// Unregister は owner guard (他人の node は消せない、 owner 無し legacy entry は掃除可)。
// v0.6.0: Discover の per-entry に `connected` (bool) を additive 追加 — relay registry
// (node_id → live connection) に居るかの snapshot。 registry 掲載 (durable) と接続生存
// (transient) は別物で、 「registry に見えるのに relay が offline」を client が事前判別
// できる (monitoring / sidebar liveness 表示の primitive)。
// v0.7.0 (ADR-021、 breaking = W2 一斉切替): federation identity 語彙を world → node へ。
// channel "worlds" → "nodes" / field "wld_id" → "node_id" / returns WorldList{worlds} →
// NodeList{nodes}。 shape・意味論は不変 (rename のみ)。 relay の to/from は元々中立名で不変。
// ID 値の prefix も wld_ → nd_ (issuer = VP 側、 hub は opaque)。 なお v0.6.0 以前の
// changelog 記述も新語彙へ retro-normalize 済み (当時の wire 名は migration guide
// docs/spec/migrations/0.2-to-0.3.md の対応表を参照)。
protocol "chronista-hub" version="0.7.0" {
    namespace "club.chronista.hub"

    // self-description — server が自分の KDL を hash 付きで返す (club-unison 組込)。
    channel "unison.discovery" from="client" lifetime="persistent" {
        request "GetProtocol" {
            field "format" type="string" required=#true
            returns "ProtocolDocument" {
                field "kdl" type="string" required=#true
                field "version" type="string" required=#true
                field "hash" type="string" required=#true
                field "codecs" type="json" required=#true
            }
        }
    }

    // node registry — VP node が自分を hub に登録し、互いを発見する。
    channel "nodes" from="client" lifetime="persistent" {
        request "Register" description="Register a VP node into the hub registry so other nodes can discover it." {
            field "handle" type="string" required=#true
            field "name" type="string"
            // node_id = location 独立 routing key (creo EntId base58、 `nd_` prefix)。 canonical。
            field "node_id" type="string"
            // endpoints = direct 到達候補 (string 配列 "[GUA]:port")。 順序付き、 空=direct 候補なし。
            field "endpoints" type="json"
            // visibility = 'public' | 'private' (v0.5.0、 ADR-020 §S5)。 省略時: 認証済 (owner
            // 記録あり) = private / 未認証 permissive = public。 'shared' は group/audience
            // モデル導入までエラー (予約席)。 owner は field でなく connection principal 由来。
            field "visibility" type="string"
            returns "Registered" {
                field "node_id" type="string"
                field "handle" type="string" required=#true
                field "registered_at" type="string" required=#true
                field "endpoints" type="json"
                field "visibility" type="string"
            }
        }

        request "Discover" description="List VP nodes visible to the caller: own nodes + public ones (anonymous callers see public only). Each entry carries `connected` (bool) = whether the node's persistent connection is alive right now (relay reachability)." {
            // nodes[] = { node_id, handle, name, endpoints[], registered_at, visibility,
            // connected } (per-entry freeform json)。 見える範囲 = 自分が owner の node +
            // public (§S5)。 connected = relay registry の生存 snapshot (v0.6.0) — false は
            // 「registry には居るが常駐接続が無い = relay は offline を返す」の事前シグナル。
            returns "NodeList" {
                field "nodes" type="json" required=#true
            }
        }

        request "Unregister" description="Deregister a VP node from the hub registry (idempotent). Provide node_id (preferred) or handle." {
            // node_id (推奨) か handle のどちらかで対象を指す (register_node と同じ rid 解決)。
            field "node_id" type="string"
            field "handle" type="string"
            returns "Unregistered" {
                field "node_id" type="string"
                field "handle" type="string"
                // removed = 削除した entry 数 (0=対象なし / 1=削除)。 idempotent。
                field "removed" type="json" required=#true
            }
        }
    }

    // relay — universal floor (ADR-020 §S4)。 direct 全滅時に hub が source→target を中継。
    // dialer が relay channel を開き open で宛先を宣言 → 以降の frame が target へ片方向 forward
    // される (payload opaque、 hub は中身を覗かない = D5)。 target 側は server-initiated `relay`
    // stream を register_server_channel("relay") で受信 (club-unison 1.5.0、 from="server")。
    channel "relay" from="client" lifetime="persistent" {
        request "open" description="Declare relay target (node_id). Subsequent frames are forwarded one-way to {to}, opaque." {
            field "to" type="string" required=#true     // 宛先 node_id
            field "from" type="string"                    // 送信元 node_id (target へ伝える)
            returns "Status" {
                // established (target へ stream 確立) / offline (target 不在 = D3-c) / error。
                field "status" type="string" required=#true
                field "detail" type="string"
            }
        }
    }
}
